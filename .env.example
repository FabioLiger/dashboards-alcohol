# Chaves de API do painel — arquivo local, NÃO versionado (ver .gitignore).
# Lido em runtime pelo Dashboards/index.html quando o painel é servido por HTTP.

GEMINI_API_KEY=cole-sua-chave-do-google-ai-studio-aqui
OPENWEATHER_API_KEY=cole-sua-chave-do-openweathermap-aqui

# Cadeia de fallback: o primeiro modelo é o preferido; em erro/limite cai para o próximo.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite
